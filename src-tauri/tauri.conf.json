{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Whisper",
  "version": "0.1.5",
  "identifier": "com.whisper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Whisper",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0QTBDQUZGOUIzQzBGN0MKUldSOER6eWIvOHFnVlBmUVkrYU9sd2RZMnVkbm00UEJsV1h5aDR3MTBTeFdOcUtwcEdDUzBOSmcK",
      "endpoints": [
        "https://github.com/AuCf/whisper/releases/latest/download/latest.json"
      ]
    }
  }
}
